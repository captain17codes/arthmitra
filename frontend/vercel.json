{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:prefix(auth|api|cases|beneficiaries|geo|meta|speech|admin|dashboard|evaluations|dpr)",
      "destination": "https://arthmitra-api.onrender.com/:prefix"
    },
    {
      "source": "/:prefix(auth|api|cases|beneficiaries|geo|meta|speech|admin|dashboard|evaluations|dpr)/:path+",
      "destination": "https://arthmitra-api.onrender.com/:prefix/:path+"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
